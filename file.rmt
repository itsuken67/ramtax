$BOOT
#$GET notiobase.txt
$MEAN WIDTH_T 80

func dword len : dword Str do:
	init dword i = 0
	until *(Str + i) = 0 do:
		inc i
	end.
	equ len = i
end.

HOME: 
	init str byte RAM = "Ramonter!\0"
	init dword it
	equ it = WIDTH_T * len {*RAM}
HEND.


